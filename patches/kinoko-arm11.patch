+    }
+    if (!selfBullet) {
+        applyKartBump(-1.0f, other, self, selfDir, normal);
+    }
+
+    // Battle (0x80570AE4..0x80570CB0): a racer bumped by a mushroom-boosting racer (bit 26)
+    // blinks (fn_1_715F4) and has a balloon stolen (RaceMode vtable +0x30), unless it is
+    // respawning, in an action or cannon, or has a Star, Mega or Bullet. Retail also refuses
+    // on bits 82, 83, 89 and 135, which this port does not produce.
+    if (battle) {
+        const bool selfMushroom = selfStatus.onBit(eStatus::MushroomBoost);
+        const bool otherMushroom = otherStatus.onBit(eStatus::MushroomBoost);
+        if (selfMushroom != otherMushroom) {
+            KartObject *victim = selfMushroom ? other : self;
+            KartObject *attacker = selfMushroom ? self : other;
+            const auto &victimStatus = victim->status();
+            if (victimStatus.offBit(eStatus::TriggerRespawn, eStatus::BattleRespawnBlink,
+                        eStatus::InRespawn, eStatus::AfterRespawn, eStatus::BeforeRespawn,
+                        eStatus::InAction, eStatus::CannonStart, eStatus::InCannon,
+                        eStatus::Star, eStatus::Mega, eStatus::Bullet)) {
+                victim->move()->startBattleBlink();
+                CallBalloonHook(BalloonEvent::Steal, victim->param()->playerIdx(),
+                        attacker->param()->playerIdx());
+            }
+        }
+    }
+
+    // KartMove vtable +0x30: bikes leave a wheelie (KartMoveBike::cancelWheelie).
+    if (self->isBike()) {
+        static_cast<KartMoveBike *>(move())->cancelWheelie();
+    }
+    if (other->isBike()) {
