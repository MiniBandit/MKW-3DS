+void ObjectPenguin::spinOut() {
+    if (m_state == State::Spin) return;
+    m_beforeSpin = m_state;
+    m_state = State::Spin;
+    m_spinTicks = 180; m_spinSpeed = 60.0f; m_spinAngle = 0.0f;
+    calcTransform(); m_spinPose = transform();
