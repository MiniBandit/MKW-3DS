+    f32 magnitude = sign * force;
+    if (victimStatus.onBit(eStatus::OverZipper)) {
+        magnitude *= 0.2f;
+    } else if (victimStatus.onBit(eStatus::AirtimeOver20)) {
+        magnitude *= 0.5f;
