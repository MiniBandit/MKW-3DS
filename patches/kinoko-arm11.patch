+/// @brief RMCU 0x80579a04 (PlayerSub10_activateStar): 450 frames of Star, refused while an
+/// action or the Bullet is active. It clears Blooper ink and lifts a crush, but not a shrink.
+/// @return Whether the Star started.
+bool KartMove::activateStar() {
+    constexpr s16 STAR_DURATION = 450; // .data 2ee8
+
+    auto &status = KartObjectProxy::status();
+    if (status.onBit(eStatus::InAction, eStatus::Bullet)) {
+        return false;
+    }
+
+    status.setBit(eStatus::Star);
+    m_starTimer = STAR_DURATION;
+    setOffroadInvincibility(STAR_DURATION);
+    status.resetBit(eStatus::Ink);
+
+    if (status.onBit(eStatus::Crushed)) {
+        status.resetBit(eStatus::Crushed, eStatus::PressAction);
+        m_kartScale->endCrush();
+        cueSound(SoundCue::PressEnd);
+    }
+
+    return true;
+}
+
+/// @brief RMCU 0x80579b8c: the Star counts down while its status is set.
+void KartMove::calcStar() {
+    auto &status = KartObjectProxy::status();
+    if (status.offBit(eStatus::Star)) {
+        return;
+    }
+
+    if (--m_starTimer < 1) {
+        status.resetBit(eStatus::Star);
+    }
+}
+
+/// @brief RMCU 0x8057a2b0 (PlayerSub10_activateMega): 450 frames of Mega. It cures a Lightning
+/// shrink and a crush, then grows through kinoko_scale_up.
+void KartMove::activateMega() {
+    constexpr s16 MEGA_DURATION = 450; // .data 2df4
+
+    auto &status = KartObjectProxy::status();
+    status.setBit(eStatus::Mega);
+    m_megaTimer = MEGA_DURATION;
+    cueSound(SoundCue::MegaUse);
+
+    if (status.onBit(eStatus::Shocked)) {
+        status.resetBit(eStatus::Shocked);
+        m_shockTimer = 0;
+        m_kartScale->endShrink(0);
+        cueSound(SoundCue::Grow);
+    }
+
+    if (status.onBit(eStatus::Crushed)) {
+        status.resetBit(eStatus::Crushed, eStatus::PressAction);
+        m_kartScale->endCrush();
+        cueSound(SoundCue::PressEnd);
+    }
+
+    m_kartScale->startShrink(1);
+    m_megaEnding = false;
+}
+
+/// @brief RMCU 0x8057a478: ends the Mega early. `immediate` also drops the collision scale.
+void KartMove::endMega(bool immediate) {
+    status().resetBit(eStatus::Mega);
+    m_megaTimer = 0;
+    if (!immediate) {
+        cueSound(SoundCue::MegaEnd);
+    }
+
+    if (!m_megaEnding) {
+        m_kartScale->endShrink(1);
+        m_megaEnding = true;
+    }
+
+    if (immediate) {
+        m_megaScale = 1.0f;
+    }
+}
+
+/// @brief RMCU 0x8057b1c4 (PlayerSub10_activateTc) sets bit 93; the cloud object clears it.
+void KartMove::setThunderCloud(bool active) {
+    if (active) {
+        status().setBit(eStatus::ThunderCloud);
+    } else {
+        status().resetBit(eStatus::ThunderCloud);
+    }
+}
