+    s16 areaId() const {
+        const s16 range = static_cast<s16>((m_rawData->_18[2] << 8) | m_rawData->_18[3]);
+        if (range < 0) {
+            return -1;
+        }
+        const s16 area = static_cast<s16>(range % 100);
+        return area == 99 ? -1 : area;
+    }
