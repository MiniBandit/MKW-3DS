+/// @addr{0x80817924}
+ObjectVeniceSaku::ObjectVeniceSaku(const System::MapdataGeoObj &params)
+    : ObjectKCL(params), m_baseY(pos().y), m_stopCued(false) {
+    s_startFrame = static_cast<s16>(params.setting(0));
+    s_distance = static_cast<f32>(static_cast<s16>(params.setting(1)));
+}
+
+ObjectVeniceSaku::~ObjectVeniceSaku() = default;
+
+/// @addr{0x808179CC}
+void ObjectVeniceSaku::calc() {
+    constexpr s32 PERIOD = 120; // 0x808D65B2
+
+    const s32 t = static_cast<s32>(System::RaceManager::Instance()->timer());
+    calcTransform();
+
+    f32 y;
+    if (s_startFrame < t) {
+        if (t < s_startFrame + PERIOD) {
+            cueSound(0x307, SoundCall::Hold);
+            const s32 frame = (t - s_startFrame) % PERIOD;
+            const f32 angle = RAD2FIDX *
+                    ((F_PI * (static_cast<f32>(frame) - 0.5f)) / static_cast<f32>(PERIOD));
+            const f32 cos = EGG::Mathf::CosFIdx(angle);
+            y = static_cast<f32>(static_cast<f64>(m_baseY) +
+                    (0.5 * static_cast<f64>(s_distance)) * static_cast<f64>(1.0f - cos));
+        } else {
+            if (!m_stopCued) {
+                cueSound(0x308, SoundCall::StartNew);
+                m_stopCued = true;
+            }
+            y = m_baseY + s_distance;
+        }
+    } else {
+        y = m_baseY;
+    }
+
+    EGG::Matrix34f mat = transform();
+    mat[1, 3] = y;
+    setTransform(mat);
+}
