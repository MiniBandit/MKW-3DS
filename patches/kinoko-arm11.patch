+    auto pose = basis.multiplyTo(yaw).multiplyTo(roll);
+    pose.setBase(3, pos()); setTransform(pose);
+    m_effectPos[2] = m_railInterpolator->curPos();
+    if (m_surfaceOffset >= 0 && m_curRot.z == 0) m_statePhase = StatePhase::End;
