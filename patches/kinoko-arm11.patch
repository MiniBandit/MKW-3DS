+/// Retail PlayerSub18_checkPlayerCollision state gate: respawn, cannon, crushed
+/// (with state bit 81) and ghost racers never touch another racer.
+bool KartCollisionExempt(const KartObject *kart) {
+    const auto &status = kart->status();
+    const auto &scenario = System::RaceConfig::Instance()->raceScenario();
+    // RMCP 0x8056F818-0x8056F914. Bits 72 and 89 have no producer in this port.
+    return scenario.players[kart->param()->playerIdx()].type ==
+            System::RaceConfig::Player::Type::Ghost ||
+            status.onBit(eStatus::TriggerRespawn, eStatus::BattleRespawnBlink, eStatus::InRespawn,
+                    eStatus::AfterRespawn, eStatus::Vanishing, eStatus::Vanished,
+                    eStatus::CannonStart, eStatus::InCannon, eStatus::AfterCannon) ||
+            (status.onBit(eStatus::Crushed) && status.onBit(eStatus::PressAction));
+}
